const ring =
  'M536.38,440c-18.98,0-34.36,15.38-34.36,34.37s15.38,34.36,34.36,34.36,34.37-15.39,34.37-34.36-15.39-34.37-34.37-34.37ZM536.38,492.62c-10.08,0-18.25-8.17-18.25-18.25s8.17-18.26,18.25-18.26,18.25,8.17,18.25,18.26-8.17,18.25-18.25,18.25Z';

// Iconos del diseño, cada uno en su círculo de 24,7 px (centro x = 94)
const icons = {
  instagram: {
    cy: 576.26,
    d: [
      'M93.95,582.93c-.86,0-1.71,0-2.56,0-2.3-.01-4.04-1.73-4.07-4.02-.02-1.74-.02-3.48,0-5.22.02-2.38,1.76-4.08,4.13-4.09,1.68,0,3.36,0,5.04,0,2.48,0,4.18,1.73,4.18,4.22,0,1.64,0,3.28,0,4.92,0,2.48-1.72,4.19-4.2,4.19-.84,0-1.68,0-2.52,0ZM94.01,581.67c.83,0,1.65,0,2.48,0,1.76,0,2.92-1.16,2.93-2.91,0-1.65,0-3.31,0-4.96,0-1.76-1.16-2.93-2.91-2.93-1.67,0-3.33,0-5,0-1.76,0-2.92,1.16-2.92,2.92,0,1.68,0,3.36,0,5.04,0,1.65,1.17,2.83,2.83,2.84.87,0,1.74,0,2.61,0Z',
      'M90.77,576.22c.02-1.8,1.49-3.24,3.3-3.23,1.83.01,3.28,1.48,3.27,3.3-.01,1.81-1.52,3.28-3.32,3.26-1.82-.03-3.26-1.51-3.24-3.33ZM94.04,574.17c-1.16,0-2.09.94-2.09,2.09,0,1.15.94,2.1,2.09,2.11,1.16,0,2.13-.97,2.12-2.12-.01-1.15-.97-2.09-2.12-2.08Z',
      'M98.31,572.78c0,.43-.37.78-.8.76-.44-.01-.77-.37-.75-.81.02-.42.35-.74.78-.74.43,0,.79.36.78.79Z',
    ],
  },
  phone: {
    cy: 609,
    d: [
      'M98.29,609.01c0,1.39,0,2.78,0,4.17,0,.37,0,.74,0,1.1,0,.49-.2.9-.56,1.22-.34.31-.75.46-1.22.46-1.27,0-2.54,0-3.81,0-.41,0-.82,0-1.24,0-.63,0-1.13-.26-1.49-.77-.19-.27-.29-.58-.29-.92,0-1.29,0-2.58,0-3.87,0-.1,0-.2,0-.3,0-1.74,0-3.48,0-5.22,0-.42-.01-.84.01-1.26.03-.52.28-.92.69-1.23.32-.24.69-.35,1.09-.34,1.34,0,2.69,0,4.03,0,.39,0,.78-.01,1.17,0,.42.02.79.19,1.1.49.35.35.52.77.51,1.27,0,1.36,0,2.72,0,4.08,0,.37,0,.75,0,1.12,0,0,0,0,0,0ZM97.12,603.32h-6.26v10.51h6.26v-10.51ZM93.91,615.39c.31,0,.58-.24.59-.54,0-.33-.24-.59-.57-.6-.31,0-.59.25-.59.55,0,.32.25.58.58.58Z',
    ],
  },
  mail: {
    cy: 639.2,
    d: [
      'M94.01,634.44c2.03,0,4.07,0,6.1,0,1.06,0,1.52.46,1.52,1.53,0,2.18,0,4.35,0,6.53,0,.97-.48,1.47-1.44,1.47-4.13,0-8.26,0-12.4,0-.97,0-1.45-.49-1.45-1.46,0-2.21,0-4.42,0-6.63,0-.96.49-1.44,1.47-1.45,2.07,0,4.13,0,6.2,0ZM93.99,640.8c2.21-1.92,4.38-3.8,6.63-5.76h-13.2c2.24,1.96,4.38,3.84,6.56,5.76ZM93.99,641.54c-.48-.42-.95-.81-1.39-1.23-.23-.22-.4-.21-.65-.04-1.39.93-2.79,1.84-4.19,2.75-.12.08-.24.17-.47.34h13.36c-.06-.09-.08-.14-.12-.16-1.53-1.01-3.06-2.01-4.6-3-.1-.06-.36,0-.47.09-.49.39-.96.81-1.47,1.25ZM86.94,635.36v7.52c1.67-1.09,3.27-2.14,4.91-3.21-1.64-1.44-3.23-2.83-4.91-4.3ZM96.16,639.67c1.64,1.07,3.24,2.11,4.87,3.18v-7.41c-1.66,1.44-3.24,2.81-4.87,4.23Z',
    ],
  },
} as const;
const R = 12.35; // radio del círculo de cada icono

const rows = [
  { key: 'instagram', label: contact.handle, href: contact.instagram, external: true },
  { key: 'phone', label: contact.phone, href: `tel:${contact.phone}`, external: false },
  { key: 'mail', label: contact.email, href: `mailto:${contact.email}`, external: false },
] as const;
---
<div class="contact-card-wrap">
  <div class="biz-card">
    <svg viewBox="32.15 379.95 576 329" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="violet-zone"><path d={violetZone} /></clipPath>
        <filter id="grain" x="0" y="0" width="100%" height="100%">
          <feTurbulence type="fractalNoise" baseFrequency="0.9" numOctaves="2" stitchTiles="stitch" />
          <feColorMatrix type="saturate" values="0" />
        </filter>
      </defs>
      <!-- zona violeta con grano; la derecha del diseño es transparente -->
      <g clip-path="url(#violet-zone)">
        <rect x="32.15" y="379.95" width="576" height="329" style="fill:var(--color-violet)" fill-opacity="0.84" />
        <rect x="32.15" y="379.95" width="576" height="329" filter="url(#grain)" opacity="0.22" style="mix-blend-mode:overlay" />
      </g>
      <path d={whiteBrace} fill="#fff" />
      <path d={ring} fill="#fff" />
      <circle cx="536.38" cy="613.57" r="18.25" fill="#fff" />
    </svg>

    <div class="biz-content">
      <h2 class="biz-title">{title}</h2>
      <div class="biz-rule" aria-hidden="true"></div>
      <ul class="biz-list">
        {rows.map((r) => (
          <li data-reveal>
            <span class="biz-icon" aria-hidden="true">
              <svg viewBox={`81.64 ${icons[r.key].cy - R} ${R * 2} ${R * 2}`} focusable="false">
                <circle cx="94" cy={icons[r.key].cy} r={R} fill="#fff" />
                {icons[r.key].d.map((d) => <path d={d} style="fill:var(--color-violet)" />)}
              </svg>
            </span>
            <a href={r.href} {...(r.external ? { rel: 'me noopener', target: '_blank' } : {})}>{r.label}</a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</div>

<style>
  .contact-card-wrap { container-type: inline-size; }

  /* --u = 1 px del diseño original (576 px de ancho) a la escala actual de la tarjeta.
     En pantallas estrechas el texto y los iconos tienen un mínimo legible (max()) y las filas
     se apoyan en la parte inferior, así que crecen hacia arriba sin pisar el título. */
  .biz-card {
    --u: calc(100cqw / 576);
    position: relative; aspect-ratio: 576 / 329; width: 100%;
    font-family: var(--font-display); color: #fff;
    border-radius: clamp(0.9rem, 4cqw, 1.5rem); overflow: hidden;
  }
  .biz-card > svg { position: absolute; inset: 0; width: 100%; height: 100%; }

  .biz-content { position: absolute; inset: 0; }

  .biz-title {
    position: absolute; left: calc(49.5 * var(--u)); top: calc(56.5 * var(--u));
    font-weight: 700; line-height: 1; letter-spacing: -0.01em;
    font-size: max(1rem, calc(26.5 * var(--u)));
    max-width: 11ch;
  }
  .biz-rule {
    position: absolute; left: calc(49.5 * var(--u)); top: calc(122.2 * var(--u));
    width: calc(240.3 * var(--u)); height: max(2px, calc(4.8 * var(--u))); background: #fff;
  }

  .biz-list {
    position: absolute; left: calc(49.5 * var(--u)); bottom: calc(57.4 * var(--u));
    display: flex; flex-direction: column; gap: max(0.3rem, calc(6.8 * var(--u)));
    font-weight: 500; font-size: max(0.72rem, calc(15.5 * var(--u)));
  }
  .biz-list li { display: flex; align-items: center; gap: max(0.45rem, calc(15 * var(--u))); min-width: 0; }
  .biz-list a { overflow-wrap: anywhere; }
  .biz-list a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .biz-icon { flex: none; display: block; width: max(1.2rem, calc(24.7 * var(--u))); height: max(1.2rem, calc(24.7 * var(--u))); }
  .biz-icon svg { display: block; width: 100%; height: 100%; }
</style>
