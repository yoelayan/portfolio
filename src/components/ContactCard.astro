---
// Tarjeta de presentación (cara de contacto), basada en el diseño de Illustrator:
//  - zona izquierda violeta con grano, cuyo borde derecho es una llave "}" con la punta hacia fuera;
//  - llave blanca que la bordea (con sus ganchos y la lengüeta de la punta);
//  - anillo y punto blancos del logo en la zona derecha, que es transparente (se ve el 3D detrás);
//  - título, línea blanca y tres datos con su icono.
// Las formas son los paths originales (viewBox del diseño: x 32.15, y 379.95, 576 × 329); el texto es
// HTML real (enlaces, selección y lectores de pantalla), no contornos.
import { contact } from '../i18n/ui';

interface Props { title: string }
const { title } = Astro.props;

// --- Geometría original del diseño ---
const violetZone =
  'M539.08,532.91v22.13c-2.3.06-4.59.26-6.86.63,0,0-.03,0-.05.01-40.82,6.48-72.03,41.85-72.03,84.49v12.24c0,12.09-5.85,22.81-14.88,29.49-2.53,1.87-5.32,3.43-8.29,4.61-4.18,1.66-8.74,2.57-13.5,2.57H32.16v-289.25h391.31c4.76,0,9.32.91,13.5,2.56,2.86,1.13,5.54,2.61,7.99,4.39,9.19,6.66,15.18,17.49,15.18,29.71v11.29c0,42.66,31.22,78.02,72.06,84.5.04,0,.08.01.12.02,2.24.35,4.5.55,6.76.61Z';
const whiteBrace =
